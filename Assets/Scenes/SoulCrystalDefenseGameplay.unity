--- !u!114 &164460244
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 164460242}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 34698b3eb77de624fb5b2a99ea2b1fd1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SoulCrystalDefense.UI.FirstWaveTutorial
  steps:
  - speaker: GUARDIAN
    instruction: 'PROTECT OUR SOUL CRYSTAL!

      LET''S PREPARE FOR WAVE ONE.'
    portrait: {fileID: 21300000, guid: eaf0d250b620bfa478f0efd399c84bff, type: 3}
    voice: {fileID: 8300000, guid: 1b5b144f34e47994faab2bd2ad303d79, type: 3}
  - speaker: GUARDIAN
    instruction: 'TAP THE GLOWING GUARDIAN CARD.

      I''LL HOLD THE FRONT LINE!'
    portrait: {fileID: 21300000, guid: eaf0d250b620bfa478f0efd399c84bff, type: 3}
    voice: {fileID: 8300000, guid: d186396306bafbb4680850038a671e21, type: 3}
  - speaker: GUARDIAN
    instruction: 'TAP THE GLOWING CENTER PATCH

      TO PLACE YOUR GUARDIAN.'
    portrait: {fileID: 21300000, guid: eaf0d250b620bfa478f0efd399c84bff, type: 3}
    voice: {fileID: 8300000, guid: bc8c8bd9dcc2ef94b8744574882d0353, type: 3}
  - speaker: ARCHER
    instruction: 'SELECT THE ARCHER CARD.

      PLACE YOUR ARCHER ON THE GLOWING
      LEFT PATCH.'
    portrait: {fileID: 21300000, guid: f54433a2fc2a0d14ba0da8b886ceacef, type: 3}
    voice: {fileID: 8300000, guid: 752aff45faa908b4187c98e264e51859, type: 3}
  - speaker: CHEF
    instruction: 'SELECT THE CHEF CARD.

      DEFEND THE GLOWING RIGHT PATCH. CHECK
      YOUR SOULS!'
    portrait: {fileID: 21300000, guid: cfdbb8b2bfd11c441a5870c7c3ea52ea, type: 3}
    voice: {fileID: 8300000, guid: ee3b5992b35351343990fdd4a9c5162b, type: 3}
  - speaker: GUARDIAN
    instruction: 'HOLD THE LINE!

      DEFEAT THE REMAINING ENEMIES TO CLEAR WAVE
      ONE.'
    portrait: {fileID: 21300000, guid: eaf0d250b620bfa478f0efd399c84bff, type: 3}
    voice: {fileID: 8300000, guid: 506bd6a53b4e1ff448d6f5095d63e7ec, type: 3}
  - speaker: MAGE
    instruction: 'WAVE ONE CLEARED!

      KEEP DEFENDING. THE WAVES ARE ENDLESS!'
    portrait: {fileID: 21300000, guid: 03596bfb04cf44b4c8d1e1aa4f2c1023, type: 3}
    voice: {fileID: 8300000, guid: afb2bf07e131c1640907b0d84ba7da5e, type: 3}
  voiceSource: {fileID: 164460245}
